#!/bin/bash

# Lint every QML file in this plugin, and syntax-check every shell, Python
# and JavaScript file beside it.
#
# Run it before committing, and let CI run it on push. Any qmllint warning
# fails the run. That verdict is taken from what qmllint printed rather than
# from its exit code: its default is to print warnings and still exit 0, and
# the flag that would change that (-W / --max-warnings) does not exist in
# every Qt 6 qmllint -- the one on an Ubuntu runner rejects it. Reading the
# output behaves the same on every version.
#
# The categories that cannot be judged outside a running Quickshell are
# turned off in .qmllint.ini, so whatever survives is worth reading.
#
# When `omarchy` is installed, the manifest is also checked with
# `omarchy plugin validate`, which mirrors what the shell's plugin registry
# accepts.
#
# Usage: scripts/lint [file ...]     (default: every QML file in the tree)

set -uo pipefail

PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_DIR" || exit 1

# qmllint ships with Qt 6 and is not always on PATH: Arch keeps it in the Qt 6
# bin directory, Debian and Ubuntu name it qmllint6.
qmllint=""
for candidate in qmllint qmllint6 /usr/lib/qt6/bin/qmllint /usr/lib/qt6/libexec/qmllint; do
  if command -v "$candidate" >/dev/null 2>&1; then
    qmllint=$candidate
    break
  fi
done

if [[ -z $qmllint ]]; then
  echo "lint: no qmllint found (install qt6-declarative, or qt6-declarative-dev-tools)" >&2
  exit 2
fi

# Files are found by globbing the working tree, not by asking git, so a copy
# without .git (a job host's snapshot, an unpacked archive) is checked just
# the same instead of silently checking nothing. Each pattern is a glob
# relative to the project directory; ** spans directories, and hidden ones
# such as .git are skipped.
list_files() {
  local pattern path
  shopt -s globstar nullglob
  for pattern in "$@"; do
    for path in $pattern; do
      [[ -f $path ]] && printf '%s\n' "$path"
    done
  done
  shopt -u globstar nullglob
}

if (($# > 0)); then
  files=("$@")
else
  mapfile -t files < <(list_files '**/*.qml')
fi

status=0

if ((${#files[@]} > 0)); then
  # The plugin's own directory is an import path, so a component in one
  # file resolves when another instantiates it. The harness's shell.qml
  # uses Hud.qml from beside it once run.sh has copied them together.
  lint_output=$("$qmllint" -I . "${files[@]}" 2>&1)
  [[ -n $lint_output ]] && printf '%s\n' "$lint_output"

  if grep -qE '^(Warning|Error):' <<<"$lint_output"; then
    # Which findings can be trusted depends on how old this qmllint is. One
    # new enough for .qmllint.ini to mean anything tags every message with
    # its [category]; an older one -- Ubuntu's, for instance -- silently
    # ignores the per-category configuration, so its semantic warnings are
    # the whole unfiltered wall of unresolved Quickshell types and say
    # nothing about this code.
    if grep -qE '\[[a-z-]+\]$' <<<"$lint_output"; then
      status=1
    elif grep -qE '(Expected token|Unexpected token|Syntax error)' <<<"$lint_output"; then
      # Parse errors mean the same thing on every version, so those still
      # fail. The rest is reported as unjudged rather than counted.
      echo "lint: QML does not parse (above)" >&2
      status=1
    else
      echo "lint: this qmllint ignores the per-category configuration, so only" >&2
      echo "      parse errors were judged; run scripts/lint on a desktop with" >&2
      echo "      Qt 6.11 or newer for the full check" >&2
    fi
  fi
else
  # This plugin is QML; finding none means the search is broken, and a
  # clean verdict would be a lie.
  echo "lint: no QML files found" >&2
  status=1
fi

# Shell scripts ship with the plugin or drive its tests; a syntax error in
# one is found here or at the worst possible moment.
mapfile -t shell_files < <(list_files 'scripts/*' 'tests/*.sh' 'tests/harness/*.sh')
for script in "${shell_files[@]}"; do
  [[ -f $script ]] || continue
  head -1 "$script" | grep -q '^#!.*\(bash\|sh\)' || continue
  bash -n "$script" || status=1
done

# Python: the example post-process script and the harness's fakes. Parsed,
# not compiled, so nothing is written beside them.
mapfile -t python_files < <(list_files 'examples/*' 'tests/*.py' 'tests/harness/*.py')
for script in "${python_files[@]}"; do
  [[ -f $script ]] || continue
  head -1 "$script" | grep -q '^#!.*python' || [[ $script == *.py ]] || continue
  python3 -I -c 'import ast, sys; ast.parse(open(sys.argv[1], encoding="utf-8").read(), sys.argv[1])' "$script" \
    || status=1
done

# JavaScript tests run under Node.
if command -v node >/dev/null 2>&1; then
  mapfile -t js_files < <(list_files 'tests/*.mjs')
  for script in "${js_files[@]}"; do
    [[ -f $script ]] || continue
    node --check "$script" || status=1
  done
fi

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$PROJECT_DIR" || status=1
fi

if ((status == 0)); then
  echo "lint: clean"
fi
exit $status
